<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.3.3</Version>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="YamlDotNet" Version="16.3.0" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../reporting/unicode/emoji-data.txt" LogicalName="Dimsum.EmojiData" /></ItemGroup>
  <ItemGroup>
    <None Include="../安裝及使用說明_Win.txt" Link="安裝及使用說明_Win.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledEngineSha256)' != ''">
    <AssemblyMetadata Include="BundledEngineSha256" Value="$(BundledEngineSha256)" />
  </ItemGroup>
</Project>
